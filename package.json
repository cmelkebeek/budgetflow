{
  "name": "budgetflow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "node --env-file-if-exists=.env --watch backend/src/main.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "typecheck": "tsc -p backend && tsc -p frontend",
    "start": "node backend/src/main.ts",
    "cli": "node --env-file-if-exists=.env backend/src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.8.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^1.65.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
