# Configuration de l'installation. Copie ce fichier en .env (à côté de docker-compose.yml) et remplis-le.
# Ne le mets jamais dans git : il contient des secrets.

# ---------- Adresse de l'app ----------
# Adresse(s) d'accès, séparées par des virgules. La première sert aux liens envoyés par e-mail ;
# toutes sont acceptées pour les passkeys (une passkey est liée au domaine où elle a été créée).
# Si la première est en https, le cookie de session est réservé au HTTPS.
PUBLIC_URL=http://localhost:3000
# Force le cookie sécurisé (true) ou non (false). Laisser vide : déduit de PUBLIC_URL.
COOKIE_SECURE=

# ---------- Chiffrement (obligatoire) ----------
# Clé de chiffrement des secrets 2FA, 32 caractères minimum. Génère-la avec : openssl rand -base64 32
# Garde-en une copie dans ton gestionnaire de mots de passe : sans elle, la 2FA devra être réactivée.
ENCRYPTION_KEY=

# ---------- E-mails (mot de passe oublié) ----------
# Laisser SMTP_HOST vide pour désactiver l'envoi. Port 587 = STARTTLS, 465 = TLS direct.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BudgetFlow <budgetflow@ton-domaine.fr>
